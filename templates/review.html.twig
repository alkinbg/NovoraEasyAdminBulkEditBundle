{% extends '@EasyAdmin/page/content.html.twig' %}
{% block content_title %}Review bulk update{% endblock %}
{% block main %}
    <p>Review the values that will be applied to {{ selected_count }} selected record(s). <strong>No changes have been saved yet.</strong></p>
    <dl class="row">
        {% for field, value in changes %}
            <dt class="col-sm-3">{{ field }}</dt>
            <dd class="col-sm-9">{{ value is same as(null) ? 'null' : (value is same as(true) ? 'true' : (value is same as(false) ? 'false' : value)) }}</dd>
        {% endfor %}
    </dl>
    {{ form_start(confirmation) }}
        {{ form_errors(confirmation) }}
        <button class="btn btn-primary" type="submit">Apply changes to {{ selected_count }} record(s)</button>
        <a class="btn btn-outline-secondary" href="{{ edit_url }}">Back to editing</a>
        <a class="btn btn-outline-secondary" href="{{ cancel_url }}">Cancel</a>
    {{ form_end(confirmation) }}
{% endblock %}
