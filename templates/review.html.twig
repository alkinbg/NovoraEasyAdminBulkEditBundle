{% extends '@EasyAdmin/page/content.html.twig' %}
{% trans_default_domain 'NovoraEasyAdminBulkEdit' %}
{% block content_title %}{{ 'page.review'|trans }}{% endblock %}
{% block main %}
    <p class="text-muted mb-3">{{ 'selection.review_description'|trans({'%count%': selected_count}) }}</p>
    <div class="card shadow-none mb-4">
        <div class="card-body">
            <dl class="row mb-0">
                {% for field, value in changes %}
                    <dt class="col-sm-4 py-2">{{ field_labels[field]|default('') ?: field }}</dt>
                    <dd class="col-sm-8 py-2">
                        {% if value is same as(true) %}{{ 'value.yes'|trans }}
                        {% elseif value is same as(false) %}{{ 'value.no'|trans }}
                        {% elseif value is same as(null) %}{{ 'value.empty'|trans }}
                        {% else %}{{ value }}{% endif %}
                    </dd>
                {% endfor %}
            </dl>
        </div>
    </div>
    {{ form_start(confirmation) }}
        {{ form_errors(confirmation) }}
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary" type="submit">{{ 'button.confirm'|trans({'%count%': selected_count}) }}</button>
            <a class="btn btn-outline-secondary" href="{{ edit_url }}">{{ 'button.back'|trans }}</a>
            <a class="btn btn-outline-secondary" href="{{ cancel_url }}">{{ 'button.cancel'|trans }}</a>
        </div>
    {{ form_end(confirmation) }}
{% endblock %}
