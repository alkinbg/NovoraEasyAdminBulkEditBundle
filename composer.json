{
  "name": "novora/easyadmin-bulk-edit-bundle",
  "description": "Explicit, validated and transactional bulk editing for EasyAdmin 5",
  "type": "symfony-bundle",
  "license": "MIT",
  "require": {
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/orm": "^3.0",
    "easycorp/easyadmin-bundle": "^5.0",
    "php": "^8.4",
    "symfony/doctrine-bridge": "^7.4 || ^8.0",
    "symfony/form": "^7.4 || ^8.0",
    "symfony/framework-bundle": "^7.4 || ^8.0",
    "symfony/security-bundle": "^7.4 || ^8.0",
    "symfony/security-csrf": "^7.4 || ^8.0",
    "symfony/twig-bridge": "^7.4 || ^8.0",
    "symfony/twig-bundle": "^7.4 || ^8.0",
    "symfony/validator": "^7.4 || ^8.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12.0",
    "symfony/var-exporter": "^7.4 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "Novora\\EasyAdminBulkEditBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Novora\\EasyAdminBulkEditBundle\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit tests",
    "analyse": "phpstan analyse src --level=8"
  }
}
